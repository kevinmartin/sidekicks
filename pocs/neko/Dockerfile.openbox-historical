# Full-source UX build; use build-ux.sh for the guarded accepted-base upgrade.
# Public upstream source pinned by archive checksum; native target architecture.
FROM golang:1.25-trixie AS server
RUN apt-get update && apt-get install -y --no-install-recommends libx11-dev libxrandr-dev libxtst-dev libgtk-3-dev libxcvt-dev libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev && rm -rf /var/lib/apt/lists/*
COPY .cache/neko-v3.2.0.tar.gz /tmp/neko.tar.gz
RUN mkdir /src && tar xzf /tmp/neko.tar.gz --strip-components=2 -C /src neko-3.2.0/server
WORKDIR /src
RUN go build -mod=readonly -buildvcs=false -o /neko ./cmd/neko

FROM node:22-trixie-slim AS client
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY viewer.js cursor.mjs ./
RUN mkdir public && npm run build

FROM node:22-trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends supervisor pulseaudio dbus-x11 xserver-xorg-video-dummy openbox tint2 picom pcmanfm thunar wmctrl x11-utils x11-xserver-utils xdg-utils adwaita-icon-theme librsvg2-common xterm feh librsvg2-bin firefox-esr xdotool xclip curl ca-certificates fonts-dejavu fonts-noto-color-emoji libgtk-3-0 libxcvt0 libgstreamer1.0-0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-pulseaudio && rm -rf /var/lib/apt/lists/*
RUN groupmod -n neko node && usermod -l neko -d /home/neko -m node && mkdir -p /tmp/.X11-unix /tmp/runtime-neko /var/log/neko /home/neko/.config/openbox /home/neko/.config/tint2 /home/neko/.local/share/applications /app/public && chmod 1777 /tmp/.X11-unix && chown -R neko:neko /tmp/runtime-neko /var/log/neko /home/neko /app
COPY --from=server /neko /usr/bin/neko
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server.mjs lease.mjs input.mjs desktop-apps.mjs /app/
COPY public /app/public
COPY --from=client /app/public/viewer.js /app/public/viewer.js
COPY config /etc/sidekicks
COPY config/firefox-policies.json /usr/lib/firefox-esr/distribution/policies.json
COPY config/firefox-autoconfig.js /usr/lib/firefox-esr/defaults/pref/sidekicks-autoconfig.js
COPY config/firefox-sidekicks.cfg /usr/lib/firefox-esr/sidekicks.cfg
COPY fixture.html /app/public/fixture.html
RUN cp /etc/sidekicks/openbox.xml /home/neko/.config/openbox/rc.xml && cp /etc/sidekicks/tint2rc /home/neko/.config/tint2/tint2rc && cp /etc/sidekicks/*.desktop /home/neko/.local/share/applications/ && rsvg-convert /etc/sidekicks/terminal.svg -o /etc/sidekicks/terminal.png && rsvg-convert /etc/sidekicks/browser.svg -o /etc/sidekicks/browser.png && rsvg-convert /etc/sidekicks/files.svg -o /etc/sidekicks/files.png && rsvg-convert -w 1280 -h 720 /etc/sidekicks/wallpaper.svg -o /etc/sidekicks/wallpaper.png && chown -R neko:neko /home/neko && chmod +x /etc/sidekicks/*.sh
RUN /etc/sidekicks/install-desktop-defaults.sh
ENV DISPLAY=:99.0 USER=neko HOME=/home/neko XDG_RUNTIME_DIR=/tmp/runtime-neko PULSE_SERVER=unix:/tmp/pulseaudio.socket
ENV NEKO_CONFIG=/etc/sidekicks/neko.yaml NEKO_SERVER_BIND=127.0.0.1:8080
HEALTHCHECK --interval=5s --timeout=3s --start-period=20s CMD curl -fsS http://127.0.0.1:7792/health || exit 1
CMD ["supervisord", "-c", "/etc/sidekicks/supervisord.conf"]
