# Official-package dependency evaluation only. This image still has the accepted
# Openbox entrypoint; it is NOT a configured or runtime-verified Xfce desktop.
FROM sidekicks-neko:3.2.0-ux1 AS xfce-core
RUN mkdir -p /usr/share/sidekicks-xfce-eval && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-xfce-eval/packages-before.tsv && sha256sum /usr/bin/neko /usr/lib/aarch64-linux-gnu/libgstreamer-1.0.so.0 /usr/lib/xorg/Xorg > /usr/share/sidekicks-xfce-eval/transport-before.sha256 && apt-get update && apt-get -s install --no-install-recommends xfwm4 xfce4-panel xfdesktop4 xfce4-settings xfce4-terminal thunar dbus-x11 > /usr/share/sidekicks-xfce-eval/core-plan.txt && apt-get install -y --no-install-recommends xfwm4 xfce4-panel xfdesktop4 xfce4-settings xfce4-terminal thunar dbus-x11 > /usr/share/sidekicks-xfce-eval/core-install.txt && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-xfce-eval/packages-after-core.tsv && sha256sum -c /usr/share/sidekicks-xfce-eval/transport-before.sha256 && sha256sum /usr/bin/neko /usr/lib/aarch64-linux-gnu/libgstreamer-1.0.so.0 /usr/lib/xorg/Xorg > /usr/share/sidekicks-xfce-eval/transport-after-core.sha256 && ldd /usr/bin/xfwm4 /usr/bin/xfce4-panel /usr/bin/xfdesktop /usr/bin/xfsettingsd /usr/bin/xfce4-terminal /usr/bin/thunar > /usr/share/sidekicks-xfce-eval/linked-libraries-core.txt && ! grep 'not found' /usr/share/sidekicks-xfce-eval/linked-libraries-core.txt && cat /usr/share/sidekicks-xfce-eval/core-install.txt && rm -rf /var/lib/apt/lists/*

FROM xfce-core AS xfce-session
RUN apt-get update && apt-get -s install --no-install-recommends xfce4-session > /usr/share/sidekicks-xfce-eval/session-plan.txt && apt-get install -y --no-install-recommends xfce4-session > /usr/share/sidekicks-xfce-eval/session-install.txt && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-xfce-eval/packages-after-session.tsv && sha256sum -c /usr/share/sidekicks-xfce-eval/transport-before.sha256 && ldd /usr/bin/xfce4-session > /usr/share/sidekicks-xfce-eval/linked-libraries-session.txt && ! grep 'not found' /usr/share/sidekicks-xfce-eval/linked-libraries-session.txt && cat /usr/share/sidekicks-xfce-eval/session-install.txt && rm -rf /var/lib/apt/lists/*

FROM scratch AS evidence
COPY --from=xfce-session /usr/share/sidekicks-xfce-eval/ /
