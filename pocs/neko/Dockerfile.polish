# Source/build-only candidate. The helper guards the exact accepted UX base ID.
FROM sidekicks-neko:3.2.0-ux1 AS polish
RUN mkdir -p /usr/share/sidekicks-polish && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-polish/packages-before.tsv && apt-get update && apt-get -s install --no-install-recommends thunar x11-xserver-utils xdg-utils adwaita-icon-theme librsvg2-common > /usr/share/sidekicks-polish/apt-plan.txt && apt-get install -y --no-install-recommends thunar > /usr/share/sidekicks-polish/apt-thunar-install.txt && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-polish/packages-after-thunar.tsv && apt-get install -y --no-install-recommends x11-xserver-utils xdg-utils adwaita-icon-theme librsvg2-common > /usr/share/sidekicks-polish/apt-utilities-install.txt && cat /usr/share/sidekicks-polish/apt-thunar-install.txt /usr/share/sidekicks-polish/apt-utilities-install.txt > /usr/share/sidekicks-polish/apt-install.txt && dpkg-query -W -f='${binary:Package}\t${Version}\t${Installed-Size}\n' > /usr/share/sidekicks-polish/packages-after.tsv && rm -rf /var/lib/apt/lists/*
COPY config /etc/sidekicks
RUN cp /etc/sidekicks/openbox.xml /home/neko/.config/openbox/rc.xml && cp /etc/sidekicks/tint2rc /home/neko/.config/tint2/tint2rc && chmod +x /etc/sidekicks/*.sh && /etc/sidekicks/install-desktop-defaults.sh && test -s /usr/share/applications/thunar.desktop && command -v xrdb && command -v xdg-open && test "$(LC_ALL=C.UTF-8 locale charmap)" = UTF-8 && test "$(HOME=/home/neko XDG_CONFIG_HOME=/home/neko/.config xdg-mime query default x-scheme-handler/https)" = sidekicks-browser-url.desktop && test "$(HOME=/home/neko XDG_CONFIG_HOME=/home/neko/.config xdg-mime query default inode/directory)" = thunar.desktop && ldd /usr/bin/thunar > /usr/share/sidekicks-polish/thunar-linked-libraries.txt && grep libgtk-3 /usr/share/sidekicks-polish/thunar-linked-libraries.txt && cp /usr/share/applications/thunar.desktop /usr/share/sidekicks-polish/ && cat /usr/share/sidekicks-polish/apt-install.txt
ENV SIDEKICKS_DESKTOP_REVISION=polish-thunar-evaluation

# Export only build/package evidence. No guest service is run to collect it.
FROM scratch AS evidence
COPY --from=polish /usr/share/sidekicks-polish/ /
