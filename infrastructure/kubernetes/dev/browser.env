BROWSER_CDP_HOST=127.0.0.1
BROWSER_CDP_PORT=9222
BROWSER_GATEWAY_LISTEN_PORT=8080
WBA_OBSERVER_PORT=8081
WBA_FIXTURE_PORT=8443
WBA_FIXTURE_DNS_SUFFIX=svc.cluster.local
WBA_FIXTURE_DIRECTORY=https://wba.sidekicks.test
WBA_FIXTURE_READINESS_LEASE=12s
WBA_BROKER_DIR=/run/sidekicks/wba
WBA_BROKER_TIMEOUT=1s
WBA_FIXTURE_TLS_CERT=/etc/sidekicks/dev/tls.crt
WBA_FIXTURE_TLS_KEY=/etc/sidekicks/dev/tls.key
WBA_FIXTURE_BROKER_TIMEOUT=2s
